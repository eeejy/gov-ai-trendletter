# 국제협력 동향지.
#
# AI 프로파일에서 이 폴더로 복사해 값만 바꾼 것이다. 코드는 한 줄도 안 고쳤다.
# 그게 이 프로파일이 있는 이유다 — 엔진이 정말 분야 무관한지 증명한다.

profile:
  id: intl-coop
  name: 국제협력 동향지
  series: "국제협력 동향지"
  subject: 국제협력

tracks:
  - key: policy
    label: 정부정책
    field_label: 정책 동향
    color: "#38E1FF"
    quota: [3, 5]
  - key: multilateral
    label: 다자기구
    field_label: 국제기구 동향
    color: "#7C6CFF"
    quota: [1, 3]
  - key: partner
    label: 협력국
    field_label: 협력국 동향
    color: "#FFB347"
    quota: [1, 3]
    # 이 분야엔 '여러 플랫폼에서 확인' 이 없다. 그 조건을 아예 안 둔다.

filter:
  require_topic: true
  min_focus: 3.5

  core:
    [국제협력, 개발협력, ODA, 공적개발원조, 다자협력, 양자협력, 국제기구,
     공여국, 수원국, 협력사업, 국제개발, 원조, 개발도상국, 글로벌 사우스,
     정상회담, 외교장관회의, 국제회의, 공동선언, 양해각서, MOU]

  # 영어 자료도 함께 본다. 한글 낱말에 안 걸리기 때문이다.
  core_en: >-
    \b(oda|official\s+development\s+assistance|multilateral|bilateral|
    development\s+cooperation|foreign\s+aid|sdgs?|unctad|oecd\s*dac)\b

  adjacent:
    [협정, 조약, 파트너십, 공동연구, 기술협력, 인적교류, 연수, 초청,
     지원사업, 무상원조, 유상원조, 차관, 신탁기금, 분담금, 기여금,
     역량강화, 지속가능발전, 기후재원, 인도적지원, 재건, 복구]
  adjacent_needs_core: true      # 이 분야는 주변어만으로는 부족하다

  weights:
    title_core: 4.0
    title_adjacent: 1.5
    body_core: 1.0
    body_adjacent: 0.3
    body_core_cap: 3
    body_adjacent_cap: 2

  exclude_title: >-
    이슈\s*트렌드|주간\s*(이슈|정리|브리핑)|한\s*주\s*(정리|요약)|
    주가|증시|코스피|환율|시황|오늘의

penalties:
  event_promo:
    score: -2.5
    pattern: 특강|세미나|웨비나|강연|설명회|시청
    unless: 공모|모집|접수|참가|공모전

  vendor_deal:
    score: -6.0
    pattern: (수주|공급\s*계약|납품|우선협상|컨소시엄\s*구성|사업자로?\s*선정)
    unless_agency_subject: true

  agency_extra: [정부, 대통령실, 국회, 외교부, 기획재정부]
