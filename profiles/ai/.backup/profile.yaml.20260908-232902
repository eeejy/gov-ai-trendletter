# 분야 정의. 이 파일 하나가 "무엇에 대한 동향지인가" 를 정한다.
#
# 다른 분야를 만들려면 이 폴더를 통째로 복사해 값만 바꾸면 된다.
# 코드는 손대지 않는다.

profile:
  id: ai
  name: AI 정보동향지
  series: "AI 정보동향지"
  # 초안 프롬프트에서 쓰는 호칭. 분야마다 말투가 달라진다.
  subject: 인공지능

# --- 트랙 --------------------------------------------------------------------
# 어느 수집원에서 왔는가로 나뉜다. 내용 분류가 아니다.
# key 는 sources.yaml 의 track 값과 맞아야 한다.
tracks:
  - key: policy
    label: 정책
    field_label: 기관 동향
    color: "#38E1FF"
    quota: [3, 5]
  - key: industry
    label: 산업
    field_label: 산업 동향
    color: "#7C6CFF"
    quota: [2, 4]
  - key: dev
    label: 개발자
    field_label: 기술 동향
    color: "#38F0A8"
    quota: [0, 1]
    # 여러 플랫폼에서 같은 이름이 확인될 때만 싣는다. 한 곳에서만 보이는 것은
    # 그 주의 핵심이 아니라 그날의 화젯거리다. 이 조건이 없는 트랙은 그냥 일반 트랙.
    require_cross_platform: 2

# --- 주제 관문 ----------------------------------------------------------------
# "이 분야가 기사의 주제인가, 스쳐 지나가는 언급인가" 를 가른다.
filter:
  require_topic: true
  min_focus: 3.5          # 이 점수 미만은 후보에서 뺀다 (예전엔 코드에 박혀 있었다)

  # core : 이 말이 제목에 있으면 이 분야 기사로 본다
  core:
    [AI, A.I., 인공지능, 머신러닝, 딥러닝, 생성형, 초거대, 언어모델, 챗봇,
     LLM, GPT, 에이전트, 파운데이션모델, 소버린]

  # 영어권 수집원(해커뉴스·Reddit)은 한글 낱말에 안 걸린다. 정규식으로 따로 본다.
  # 예전엔 scoring.py 에 박혀 있어서, 키워드를 다 바꿔도 영문 AI 낱말이 계속
  # 관문을 통과시켰다.
  core_en: >-
    \b(ai|llm|gpt|claude|gemini|llama|agent|rag|model|inference|
    transformer|openai|anthropic|deepseek|qwen|mistral|gpu|cuda)\b

  # adjacent : 단독으로는 부족하고 본문에 core 가 함께 있어야 한다
  # (2026-09-08: 주석은 그랬는데 코드는 제목 적중만으로 점수를 줬다. 아래
  #  adjacent_needs_core 로 실제 동작을 고를 수 있게 했다. 기존 동작은 false.)
  adjacent:
    [지능형, 알고리즘, 데이터센터, 디지털전환, 자율운항, 무인, 반도체,
     GPU, 클라우드, 로봇, 빅데이터, 디지털트윈,
     예측모델, 수치예보, 공공데이터, 데이터개방, 데이터관계, 학습데이터,
     자동화, 판독, 영상분석, 음성인식]
  adjacent_needs_core: false

  weights:
    title_core: 4.0       # 제목에 core 하나라도
    title_adjacent: 1.5
    body_core: 1.0        # 본문 core 개당, 최대 3개
    body_adjacent: 0.3    # 본문 adjacent 개당, 최대 2개
    body_core_cap: 3
    body_adjacent_cap: 2

  # 동향이 아니라 목록인 글. 관문에서 즉시 뺀다.
  exclude_title: >-
    이슈\s*트렌드|주간\s*(이슈|정리|브리핑)|한\s*주\s*(정리|요약)|
    주가|증시|코스피|코스닥|시황|급등|급락|오늘의|이번\s*주\s*인기

# --- 감점 규칙 ----------------------------------------------------------------
# 예전엔 정규식이 scoring.py 에 박혀 있었다. 기관 이름까지 코드에 있었다.
penalties:
  event_promo:
    score: -2.5
    pattern: 특강|세미나|웨비나|강연|설명회|간담회|즐겨요|보러오세요|시청
    # 직원이 참여할 수 있는 행사는 감점하지 않는다
    unless: 경진대회|공모전|해커톤|공모|모집|접수|참가|아이디어

  vendor_deal:
    score: -6.0
    pattern: >-
      (개발\s*참여|사업자로?\s*선정|주관기관\s*선정|수주|공급\s*계약|
      구축\s*계약|납품|우선협상|컨소시엄\s*구성|출사표)
    # 제목이 기관으로 시작하면 기관 발표다. 업체가 주어면 홍보다.
    # 기관 목록은 ontology 의 기관 그룹에서 자동으로 만든다 (agency_from_ontology).
    unless_agency_subject: true

  overseas:
    score: -5.0
    pattern: >-
      (^|[\s\[(])(日|美|中|英|獨|佛|일본|미국|중국|영국|독일|프랑스|호주|캐나다|
      싱가포르|대만|인도|베트남|EU|유럽연합)\s*(경찰|소방|정부|당국|내무)
    # 해외 기관 소식과 지방 조직 소식은 둘 중 하나만 매긴다 (배타)
    exclusive_group: peer

  local_peer:
    score: -3.5
    pattern: >-
      (서울|부산|대구|인천|광주|대전|울산|세종|경기|강원|충북|충남|전북|전남|
      경북|경남|제주)\s*(자치)?(경찰|소방|지방경찰|경찰청|소방본부|소방서)
    # 우리 기관은 빼고 본다 — '부산해경 드론 순찰' 같은 건 살려야 한다
    unless_contains: 해경
    exclusive_group: peer

  # 기관 주어 판정에 쓸 기관 이름을 온톨로지에서 가져온다.
  # 여기 추가로 더 넣고 싶으면 적는다.
  agency_extra: [정부, 대통령실, 청와대, 국회, 감사원]
