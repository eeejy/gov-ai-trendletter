# 앱 전역 설정. 분야가 정하는 값은 profiles/<분야>/ 에 있다.

# 지금 쓰는 분야. `python run.py profile list` 로 목록을 본다.
profile: uxtest

# 발행 기관 정보. 쓰는 기관에 맞게 바꾼다.
issue:
  series: "해양안전 정보동향"
  publisher: 해양경찰청
  team: 정보통신과
  year: 2026
  number:                 # null 이면 data/issues 의 마지막 호 + 1
  weekday_label: 금        # 발행 요일 표기

collect:
  days: 7                 # 기본 수집 기간 (최근 7일)
  max_per_source: 60
  timeout: 25
  # 수집원을 함께 돌린다. 서로 다른 사이트라 무리가 없고, 느린 곳 하나가
  # 전체를 붙잡지 않는다. 해외 러너에서 국내 사이트가 느릴 때 특히 중요하다.
  workers: 8
  user_agent: "KCG-TrendLetter/0.1 (+internal use)"
  cache_hours: 6          # 같은 URL 재수집 방지

compose:
  total_max: 8            # 전체 최대 8건
  # 트랙별 목표 건수는 profiles/<분야>/profile.yaml 의 tracks 로 옮겼다.
  quota_moved_to_profile: true
  _old_quota:             # 참고용. 읽지 않는다.
    # 지난 11개호는 기관 동향·정부정책이 절반 이상이었다.
    # 개발자 트랙은 종합 항목 1건으로 충분해 상한을 1로 둔다.
    # 8건으로 늘리며 다시 잡았다. 정책이 절반을 넘던 지난 11개 호의 비율은
    # 유지하되, 산업·기술 소식이 핫이슈 자리로만 밀려나지 않게 상한을 뒀다.
    policy: [3, 5]
    industry: [2, 4]
    dev: [0, 1]
  must_include_roles: [must]   # 점수와 무관하게 후보에 자동 포함
  # 개발자 트랙은 여러 플랫폼에서 같은 이름이 확인될 때만 싣는다.
  # 한 곳에서만 보이는 저장소는 그 주의 핵심 기술이 아니라 그날의 화젯거리다.
  dev_min_platforms: 2
  # 새 모델·도구 소식은 매 호 최소 이만큼 남긴다.
  # 정책·공공 이슈만 채우면 '무슨 도구가 나왔는지' 를 아예 놓친다.
  min_tool_news: 1
  # 같은 사건을 여러 매체가 다른 제목으로 쓴 것을 목록에서 한 번만 보여 준다.
  # 제목 유사도로는 안 묶인다 — 실측 유사도 0.21~0.28.
  drop_same_event: true

  # 순위를 매기기 전에 본문이 빈 항목의 본문을 받아 온다.
  # 목록에 제목만 주는 수집원(서울 AI 플랫폼·Hacker News 등)이 제목만으로
  # 평가돼 밀리던 문제를 없앤다. 65건에 9초쯤 걸린다.
  enrich_before_rank: true

  # 규칙 점수 상위 rerank_pool 개를 Claude 가 본문까지 읽고 다시 고른다.
  # 규칙 점수는 낱말이 걸린 횟수라, 본문을 채우면 정책 자료와 함께
  # 개발 잡음도 오른다. 이 단계가 그 둘을 가른다. 90초쯤 걸린다.
  # 끄면 규칙 점수만으로 고른다(빠르지만 품질이 떨어진다).
  #   같은 주 자료로 blind 심사 3회: 규칙만 46점 / 본문만 56점 / 둘 다 89점
  llm_rerank: true
  # 상위 몇 개를 Claude 에게 넘길지. 40 으로는 빠듯했다 — 최종 8건 중 4건이
  # 21~40위에서 나왔고 그중 하나는 정확히 40위였다. 60 으로 넓히니 3건이
  # 41~53위에서 나왔다. 규칙 점수와 인사이트 값어치의 상관이 약하다는 뜻이다.
  # 점수 분포상 8.0점 이상이 59개라 60 이 자연스러운 경계다. (+32초)
  rerank_pool: 60
  rerank_min_score: 8.0   # 이 아래는 넘기지 않는다. 관문 언저리 잡음이다
  # 이번 주 가장 많이 언급된 기술·모델은 개별 기사가 아니라
  # '조사·종합 정리' 항목으로 싣는다. 개발자 개인 게시글 요약이 되지 않도록.
  topic_slots: 2
  topic_min_mentions: 2

# 초안 작성. Claude Code CLI 를 그대로 쓴다(별도 API 키 없음).
# 초안 작성에 쓸 모델. 넷 중에서 고른다.
#   claude_cli  설치된 Claude Code (키 없이 구독 그대로)
#   anthropic   Anthropic API      (pip install anthropic + 키)
#   openai      OpenAI API         (키)
#   ollama      내 컴퓨터 모델      (키 불필요, ollama serve)
#   gemini      Google Gemini      (키, 무료 티어 있음)
llm:
  enabled: true
  provider: claude_cli
  timeout: 180       # 항목 1건당 초
  max_items: 8       # 한 번에 초안을 만들 최대 항목 수
  workers: 5         # 항목별 초안을 몇 개씩 함께 쓸지

  claude_cli: {command: claude, model: ""}
  anthropic: {model: claude-opus-5, max_tokens: 16000}
  openai: {model: gpt-5, base_url: ""}
  ollama: {model: "", base_url: "http://localhost:11434/v1"}
  gemini: {model: gemini-3.1-flash-lite, max_tokens: 8192}

dedupe:
  title_similarity: 0.72  # 이 값 이상이면 같은 이슈로 통합
  window_days: 10
  # 제목 유사도만으로는 영어 기사가 안 묶인다. 같은 모델·도구 이름을 다루면
  # 한 사건으로 합친다. (2026-08-30: GLM 관련 소식이 7개 이슈로 흩어졌음)
  merge_by_entity: true
  entity_min_similarity: 0.30

output:
  # 글꼴은 발행물 안에 쓰인 글자만 잘라 담는다 (assets/fonts/README.md)
  #   display: 표지 큰 제목·항목 제목·배지  (paperlogy | pretendard)
  #   body   : 본문 개조식·시사점·관련자료  (pretendard | paperlogy)
  # Paperlogy 는 발표용으로 만들어져 큰 글자에 어울리고,
  # Pretendard 는 숫자·괄호가 많은 본문에서 줄이 고르게 앉는다.
  display_font: paperlogy
  body_font: pretendard


  html_dir: data/issues
  draft_dir: data/drafts
  raw_dir: data/raw

telegram:
  enabled: true
  max_items: 6
  # 토큰과 대상 방은 config/secrets.yaml 에 둔다 (git 제외).
  #   telegram:
  #     token: "123456:ABC-DEF..."
  #     chat_id: "-1001234567890"
  # 환경변수 TRENDLETTER_TELEGRAM_TOKEN / TRENDLETTER_TELEGRAM_CHAT_ID 도 된다.
  #
  # 발송할 때 HTML 전문 주소를 함께 붙인다. 모바일에서 바로 열린다.
  # 사내망 파일서버·그룹웨어 등 직원이 접근할 수 있는 주소를 적는다.
  html_base: ""        # 예: https://intra.example.go.kr/ai-trend/

# 일간 브리핑 — 주간 동향지와 별개다.
# Claude 를 쓰지 않고 수집·점수만으로 상위 몇 건의 제목·본문 앞머리·링크를 보낸다.
# 시사점을 쓰지 않는 이유: 사람 검토 없이 자동 발송되므로 지어낸 문장을 싣지 않는다.
daily:
  top: 6
  min_score: 8.0        # 이 점수 미만은 싣지 않는다 (없으면 "없습니다" 로 보낸다)

editor:
  host: 127.0.0.1
  port: 8765
